@article{Romanowicz24,
author = {Romanowicz, M, and Saliba, M},
title = {18.2 Preemption of Disruptive Behavior in Children: parent Child Interaction Therapy Augmented With Artificial Intelligence},
journal = {Journal of the American Academy of Child and Adolescent Psychiatry},
volume = {63},
number = {10},
pages = {S338},
year = {2024},
accession_number = {EMBASE 2034821106},
publication type = {Conference proceeding},
keywords = {*artificial intelligence; *disruptive behavior; *parent; *parent‐child interaction therapy; Child; Child behavior; Clinical article; Conference abstract; Controlled study; Decision tree; Double blind procedure; Evidence based practice; Female; Heart rate; Human; Male; Mental health service; Pilot study; Preschool child; Randomized controlled trial; Sleep pattern; Smartphone; Wearable device; Wearable technology},
abstract = {Objectives: Disruptive behaviors are the most common reason why preschool children present to mental health services. Parent‐child interaction therapy (PCIT) is an evidence‐based therapy for disruptive behaviors that is highly effective. Unfortunately, a number of families that struggle to engage in daily practices with their children remain. Wearable technologies not only allow for daily monitoring of the children’s behaviors but also help researchers to send targeted behavioral alerts to the parents to increase their engagement. Here we will present the results of 2 studies: 1) an inpatient, pilot study in which we gathered evidence for wearables in augmenting care management in children with disruptive behaviors; and 2) a randomized double‐blind controlled trial that used artificial intelligence (AI) technology to study real‐time predictive patterns of behaviors in young children undergoing PCIT. Methods: In an inpatient study, 11 children were asked to wear a Garmin Vivosmart4 Smartwatch that was paired with a smartphone. Data were transmitted (sleep cycles, duration, and sequence of cycles, heart rate, level of activity) from the watch through the GarminConnect portal and downloaded via Fitabase. From that data, a decision tree to predict the onset of disruptive behavior was created. The decision tree was used in a randomized controlled trial in which 50 children were assigned to either standard PCIT or PCIT augmented with AI technology (PCIT‐AI). The parents of the PCIT‐AI group were able to receive targeted messages before disruptive behavior began (thanks to decision tree technology), which increased parental engagement. Results: In the pilot study, the participants had a 90% adherence rate for smartwatch use. Decision trees (heart rate, sleep, and level of activity) demonstrated 80.89% accuracy of predicting the child’s behavior state. Conclusions: Smartwatches were well tolerated by children aged 3 to 7 years old. PCIT‐AI is a promising treatment for disruptive behaviors. DBD, P},
DOI = {10.1016/j.jaac.2024.07.734},
URL = {https://www.cochranelibrary.com/central/doi/10.1002/central/CN-02759102/full}
}


