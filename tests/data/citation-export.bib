@article{NCT0661689624,
author = {NCT06616896,},
title = {Precision Rehabilitation: mechanisms and Efficacy of Vibration in Exercise Training for Degenerative Knee Osteoarthritis},
journal = {https://clinicaltrials.gov/ct2/show/NCT06616896},
year = {2024},
