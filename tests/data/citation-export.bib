@article{NCT0503129921,
author = {NCT05031299,},
title = {Lifestyle-related Early Detection and Intervention for Older Adults & Elderly at Risk for Metabolic Syndrome},
journal = {https://clinicaltrials.gov/show/NCT05031299},
