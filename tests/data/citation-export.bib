@article{Tan25,
author = {Tan, Y, and Wei, J},
title = {EXPLORING INTERVENTION EFFECTS OF DIGITAL TWIN CITY STRESS VISUALIZATION SYSTEMS ON MENTAL CRISIS EARLY WARNING FOR OCCUPATIONAL POPULATIONS},
journal = {Current opinion in psychiatry},
volume = {38},
