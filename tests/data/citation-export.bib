@article{Gandara24,
author = {Gandara, VI, Besterman, AD, Blucher, C, Tasarz, J, Reyes Martinez, CC, Smarr, BL, and Kim, K},
title = {5.33 Feasibility of Wearable Devices as a Source of Data to Support HealthAI in ASD Populations},
journal = {Journal of the American Academy of Child and Adolescent Psychiatry},
volume = {63},
number = {10},
pages = {S266},
year = {2024},
accession_number = {EMBASE 2034825430},
publication type = {Conference proceeding},
keywords = {*wearable device; Adolescent; Adult; Aggression; Caregiver; Child; Clinical article; Cognition; Conference abstract; Controlled study; Daily life activity; Device comparison; Diagnosis; Female; Human; Male; Semi structured interview; Social behavior; Sphygmomanometer; Wearable sensor},
abstract = {Objectives: Wearable sensor devices (wearables) are increasingly used in healthcare settings due to their continuous collection of data, which can provide meaningful insights that may be missed during office appointments. For youth with ASD, wearables have been indicated to aid in diagnosing ASD, predicting aggression, and improving social behavior. However, individuals with ASD may have sensitivities to sensations caused by the devices, thereby impeding their practicality. This study investigates the tolerability of 4 wearable devices in adolescents with ASD. Methods: Forty adolescents (age 13‐17 years) with a diagnosis of ASD, along with 1 caregiver for each adolescent, were recruited from the Rady Children’s Hospital San Diego. The adolescents were randomized to 1 of 4 wearable devices; MUSE S headband, Fitbit Inspire 2 wristband, Wellue ring, or Vivalink Adhesive patch. Participants were asked to wear the device per manufacturer’s guidelines for 2 weeks while continuing their normal daily activities. At an initial appointment, the caregiver completed the behavioral assessments, while the patient completed NIH Toolbox cognitive and emotional assessments. In addition, semistructured interviews were conducted before and after the use of the device. Results: Our study will focus on the completeness of data collected over the 2‐week trial across the different devices. Completeness of the collected data will serve as a proxy for tolerability. Participants will be asked to report comfort and usability of their assigned device as well. Semi‐structured interviews will help inform us about participants’ subjective experiences with the devices. Conclusions: Current studies exploring the use of wearable devices in individuals with ASD often focus on a single device while being conducted in laboratory settings. Our study will investigate the use of 4 different devices used in the participants’ natural settings. This will provide a more realistic depiction of the impact and usability of wearables in the participants’ everyday life. ASD, SII},
DOI = {10.1016/j.jaac.2024.08.354},
URL = {https://www.cochranelibrary.com/central/doi/10.1002/central/CN-02769151/full}
}


