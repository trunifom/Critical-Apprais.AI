	collaborator = {DIPF {\textbar} Leibniz-Institut für Bildungsforschung und Bildungsinformation},
	year = {2011},
	note = {ISBN: 9783866494619
Publisher: Verlag Barbara Budrich : Opladen ; Berlin ; Farmington Hills, Mich.},
	keywords = {Attention, 370 Education, 370 Erziehung, Schul- und Bildungswesen, Aufmerksamkeit, Deutschland, Erhebungsinstrument, Germany, Handlungsorientierter Unterricht, Learning achievement, Learning conditions, Lehr-Lern-Prozess, Lernbedingungen, Lernerfolg, Mail surveys, Teaching quality, Teaching-learning process, Traditional schools, Traditioneller Unterricht, Unterrichtsqualität},
