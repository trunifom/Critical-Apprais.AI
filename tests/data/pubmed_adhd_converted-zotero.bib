@article{rosenblum_computerized_2003-1,
	title = {Computerized {Temporal} {Handwriting} {Characteristics} of {Proficient} and {Non}-{Proficient} {Handwriters}},
	volume = {57},
	issn = {0272-9490, 1943-7676},
	url = {https://research.aota.org/ajot/article/57/2/129/4748/Computerized-Temporal-Handwriting-Characteristics},
	doi = {10.5014/ajot.57.2.129},
	abstract = {OBJECTIVE. The purpose of this study was to use computerized temporal measures to examine and compare the writing process of proficient and non-proficient third grade handwriters.
METHOD A computerized digitizer system was used to compare the temporal handwriting measures of two groups of 8-9 year old students. Classroom teachers used a questionnaire to identify 50 students who were non-proficient handwriters and 50 students who were proficient handwriters. MANOVA analyses were used to test for the group differences across tasks for each dependent variable. Total time, “on paper” time, “in air” time, speed and number of characters per minute were recorded as the participants performed graded writing tasks.
RESULTS Non-proficient handwriters required significantly more time to perform handwriting tasks (F(4,91) = 14.83, p{\textless}.0001); their “in air” time, was especially longer as compared to the proficient handwriters (F(4,91) = 13.63, p{\textless}.0001). Their handwriting speed was slower (F(4,91) = 5.99, p{\textless}.0002), and they wrote fewer characters per minute (F(4,91) = 14.63, p{\textless}.0001).
CONCLUSION The use of a computerized handwriting system provides objective temporal measures of handwriting performance, and may lead to the development of additional tools for the evaluation and treatment of handwriting difficulties.},
	language = {en},
	number = {2},
	urldate = {2022-05-20},
	journal = {The American Journal of Occupational Therapy},
	author = {Rosenblum, Sara and Parush, Shula and Weiss, Patrice L.},
	month = mar,
	year = {2003},
	note = {Number: 2},
	pages = {129--138},
}

